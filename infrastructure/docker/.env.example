# Development-only placeholders. Copy this file to .env and keep .env local.
# Never reuse these values in a shared, staging, or production environment.

COMPOSE_PROJECT_NAME=traderpro-agrisuite

POSTGRES_IMAGE=postgres:18
POSTGRES_DB=traderpro_dev
POSTGRES_USER=traderpro_dev
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_PORT=5432

# Future API/Worker profile placeholders. These images do not exist yet.
TRADERPRO_API_IMAGE=traderpro-api:scaffold-placeholder
TRADERPRO_WORKER_IMAGE=traderpro-worker:scaffold-placeholder
TRADERPRO_API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
