{
  "contract": "TraderPro.CommercialMobile.HttpExamples",
  "contractVersion": 1,
  "capabilityPlaceholder": "<runtime-secret-or-capability-not-frozen>",
  "routes": [
    { "name": "redeemActivation", "method": "POST", "path": "/api/v1/auth/device-activations/redeem", "authorization": "Anonymous" },
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "authorization": "Anonymous" },
    { "name": "refresh", "method": "POST", "path": "/api/v1/auth/refresh", "authorization": "Anonymous" },
    { "name": "logout", "method": "POST", "path": "/api/v1/auth/logout", "authorization": "CommercialUser" },
    { "name": "logoutAll", "method": "POST", "path": "/api/v1/auth/logout-all", "authorization": "CommercialUser" },
    { "name": "me", "method": "GET", "path": "/api/v1/auth/me", "authorization": "CommercialUser" },
    { "name": "issueActivationCode", "method": "POST", "path": "/api/v1/devices/{deviceId}/activation-codes", "authorization": "Owner" },
    { "name": "operations", "method": "POST", "path": "/api/v1/mobile/commercial-sync/operations", "authorization": "Operator" },
    { "name": "events", "method": "GET", "path": "/api/v1/mobile/commercial-sync/events?cursor={opaque}&limit={1-100}", "authorization": "OperatorOrOwner" },
    { "name": "masters", "method": "GET", "path": "/api/v1/mobile/commercial-sync/masters?cursor={opaque}&limit={1-100}", "authorization": "OperatorOrOwner" },
    { "name": "listSessions", "method": "GET", "path": "/api/v1/procurement/receiving-sessions?status={optional}&search={optional}&cursor={opaque}&limit={1-100}", "authorization": "OperatorOrOwner" },
    { "name": "liveView", "method": "GET", "path": "/api/v1/procurement/receiving-sessions/{id}/live-view", "authorization": "OperatorOrOwner" },
    { "name": "heartbeat", "method": "POST", "path": "/api/v1/procurement/receiving-sessions/{id}/lease/heartbeat", "authorization": "Operator" },
    { "name": "reacquire", "method": "POST", "path": "/api/v1/procurement/receiving-sessions/{id}/lease/reacquire", "authorization": "Operator" },
    { "name": "transfer", "method": "POST", "path": "/api/v1/procurement/receiving-sessions/{id}/ownership/transfer", "authorization": "Owner" },
    { "name": "getReferencePolicy", "method": "GET", "path": "/api/v1/procurement/receiving-reference-policy", "authorization": "Owner" },
    { "name": "updateReferencePolicy", "method": "PUT", "path": "/api/v1/procurement/receiving-reference-policy", "authorization": "Owner" }
  ],
  "authenticationExamples": {
    "activation": {
      "request": {
        "workspaceCode": "DEMO-WORKSPACE",
        "activationCode": "<one-time-code-not-frozen>",
        "clientInstallationReference": "install-001",
        "deviceLabel": "Receiving device 1",
        "platform": "Android"
      },
      "response": {
        "deviceId": "019fc400-0000-7000-8000-000000000201",
        "deviceSecret": "<runtime-secret-not-frozen>",
        "activatedAtUtc": "2026-08-02T07:00:00+00:00",
        "secretVersion": 1
      }
    },
    "login": {
      "request": {
        "workspaceCode": "DEMO-WORKSPACE",
        "login": "operator",
        "password": "<runtime-password-not-frozen>",
        "deviceId": "019fc400-0000-7000-8000-000000000201",
        "deviceSecret": "<runtime-secret-not-frozen>"
      },
      "response": {
        "accessToken": "<runtime-access-token-not-frozen>",
