          "defaultBranchId": "019fc400-0000-7000-8000-000000000202"
        },
        "device": {
          "deviceId": "019fc400-0000-7000-8000-000000000201",
          "label": "Receiving device 1"
        }
      }
    },
    "refresh": {
      "request": {
        "refreshToken": "<runtime-refresh-token-not-frozen>"
      },
      "response": "same shape as authenticationExamples.login.response with newly rotated runtime tokens"
    },
    "logout": {
      "request": null,
      "responseStatus": 204
    },
    "logoutAll": {
      "request": null,
      "responseStatus": 204
    },
    "me": {
      "request": null,
      "response": {
        "user": {
          "userId": "33333333-3333-4333-8333-333333333333",
          "displayName": "Receiving Operator",
          "role": "Operator"
        },
        "workspace": {
          "workspaceId": "11111111-1111-4111-8111-111111111111",
          "workspaceCode": "DEMO-WORKSPACE"
        },
        "company": {
          "companyId": "22222222-2222-4222-8222-222222222222",
          "defaultBranchId": "019fc400-0000-7000-8000-000000000202"
        },
        "device": {
          "deviceId": "019fc400-0000-7000-8000-000000000201",
          "label": "Receiving device 1"
        },
        "tokenFamilyId": "019fc400-0000-7000-8000-000000000203"
      }
    }
  },
  "ownershipExamples": {
    "heartbeat": {
      "headers": {
        "Idempotency-Key": "synthetic-heartbeat-001"
      },
      "request": {
        "ownershipGeneration": 1,
        "leaseId": "<runtime-lease-capability-not-frozen>"
      }
    },
    "sameDeviceReacquisition": {
      "headers": {
        "Idempotency-Key": "synthetic-reacquire-001"
      },
      "request": {
        "ownershipGeneration": 1
      },
      "response": {
        "sessionId": "019fc400-0000-7000-8000-000000000010",
        "sessionVersion": 2,
        "editorDeviceId": "44444444-4444-4444-8444-444444444444",
        "ownershipGeneration": 1,
        "leaseId": "<new-runtime-lease-capability-not-frozen>",
        "leaseExpiresAtUtc": "2026-08-02T10:00:00+00:00",
        "ownershipVersion": 3
      }
    },
    "transfer": {
      "headers": {
        "Idempotency-Key": "synthetic-transfer-001",
        "X-Expected-Version": "2"
      },
      "request": {
        "targetDeviceId": "55555555-5555-4555-8555-555555555555",
        "expectedOwnershipGeneration": 1,
        "reason": "Operator device unavailable"
      },
      "response": {
        "sessionId": "019fc400-0000-7000-8000-000000000010",
        "sessionVersion": 3,
        "editorDeviceId": "55555555-5555-4555-8555-555555555555",
        "ownershipGeneration": 2,
        "leaseId": null,
        "leaseExpiresAtUtc": null,
        "ownershipVersion": 2
      }
    },
    "acquisitionRequired": {
      "leaseHealth": "AcquisitionRequired",
      "attention": "LeaseAcquisitionRequired"
    },
    "staleGeneration": {
      "status": "NeedsAttention",
      "error": {
        "code": "RECEIVING_OWNERSHIP_GENERATION_STALE",
        "retryable": false,
        "requiresAction": true
      }
    }
  },
